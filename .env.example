# Copy to .env if you want to override defaults. No keys are required.

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge

# Optional: if set, /query will ask this model to write a short answer
# from retrieved context. Without it, the API returns extractive RAG.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Wikimedia requires a descriptive User-Agent.
WIKI_USER_AGENT=airflow-chroma-rag/1.0 (portfolio; contact: you@example.com)

AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
